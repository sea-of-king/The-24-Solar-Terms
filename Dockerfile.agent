ARG BASE_IMAGE=python:3.12.14-slim-trixie
FROM ${BASE_IMAGE}
WORKDIR /app
USER root

ARG INSTALL_DEPS=true
COPY requirements.txt ./
RUN if [ "${INSTALL_DEPS}" = "true" ]; then pip install --no-cache-dir -r requirements.txt; fi

COPY app ./app
COPY assistant_core ./assistant_core
COPY domains ./domains
COPY worker ./worker
COPY agent_server.py assistant_factory.py solar_term_agent.py ./
RUN addgroup --system assistant && adduser --system --ingroup assistant assistant \
    && chown -R assistant:assistant /app
USER assistant
ENV PYTHONUNBUFFERED=1
ENV AGENT_HOST=0.0.0.0
ENV AGENT_PORT=8765
EXPOSE 8765
CMD ["sh", "-c", "uvicorn app.main:app --host ${AGENT_HOST} --port ${AGENT_PORT} --proxy-headers"]
